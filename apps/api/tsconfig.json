{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "erasableSyntaxOnly": false,
    // Typecheck against the packages' sources, so CI does not need a build first.
    "paths": {
      "@darksouls-challenge/core": ["../../packages/core/src/index.ts"],
      "@darksouls-challenge/contracts": ["../../packages/contracts/src/index.ts"],
      "@darksouls-challenge/db": ["../../packages/db/src/index.ts"],
      "@darksouls-challenge/messaging": ["../../packages/messaging/src/index.ts"]
    }
  },
  "include": ["src", "test", "../../test/provided.d.ts"]
}
