{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "darksouls-challenge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Server",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // One instance: the rate limits and the signal to the worker live in the process.
      "max_instances": 1,
      // Generating is pure CPU, and a Spring server takes its time to start on a fraction of a core. A custom type asks for at least
      // 3 GiB of memory per vCPU, though the server uses about 300 MiB.
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 2000 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Server", "name": "SERVER" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Server"], "tag": "v1" }]
}
